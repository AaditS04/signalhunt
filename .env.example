# ---- Model provider (optional; without it SignalHunt uses its deterministic rule-based extractor) ----
ANTHROPIC_API_KEY=
SIGNALHUNT_MODEL=claude-opus-5-5
SIGNALHUNT_EFFORT=low

# ---- Crustdata (optional but recommended: web search/fetch, company identity, decision-makers) ----
CRUSTDATA_API_KEY= cd_2ae8b356d87c80aa400ed53456e6862b495a
# Assumed price of one Crustdata credit in USD (for the cost ledger). Adjust to your contract.
CRUSTDATA_USD_PER_CREDIT=0.01
# Extra discovery via Crustdata web search for the first N queries (0 = off; Bing News RSS is primary)
CRUSTDATA_SEARCH_QUERIES=0

# ---- Run limits (each run stops cleanly when a limit is reached) ----
MAX_RUN_COST_USD=1.50
MAX_RUN_SECONDS=600
MAX_ARTICLES_PER_RUN=25
MAX_LLM_CALLS_PER_RUN=40

# ---- Currency for reporting ----
USD_INR=88.0

# ---- Outreach delivery ----
# sandbox = write approved emails to data/outbox (test mode). smtp = send through SMTP below.
OUTREACH_MODE=sandbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Storage ----
SIGNALHUNT_DB=data/signalhunt.db

# ---- Event contact rule: agents may only contact teammates and organisers ----
# Comma-separated addresses or @domains. In smtp mode an empty list blocks every send.
ALLOWED_RECIPIENTS=@pilani.bits-pilani.ac.in
# Teammate addresses that play the buyer; their replies are accepted and labelled ROLE_PLAY.
ROLEPLAY_SENDERS=
# Distress-news check on Google News RSS (1 = on)
TRUST_NEWS_CHECK=1
